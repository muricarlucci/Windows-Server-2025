[CmdletBinding()]
param(
    [ValidateSet('Preparar','CriarVM','ConfigurarBase','CriarContaAdmin','IngressarDominio','ConfigurarPAW','InstalarRSAT','Validar')]
    [string]$Acao='Preparar',
