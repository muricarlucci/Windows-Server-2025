)
Set-StrictMode -Version Latest
$ErrorActionPreference='Stop'

$Base='D:\FIAP\WINDOWS\SmartFactory-GS'
$VM='PAW-TI01'
$NomeAdaptador='ADMIN-PAW'
$DirVM=Join-Path $Base '02-VMs\PAW-TI01'
$DiscoOS=Join-Path $DirVM 'PAW-TI01-WIN11-OS.vhdx'
$DirISO=Join-Path $Base '01-ISOs'
$Log=Join-Path $Base '09-Logs-Testes\11-PAW-TI01-Administracao-Segura-Resultado.txt'
