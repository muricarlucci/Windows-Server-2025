function Registrar([string]$Mensagem) {
    $linha=('{0} | {1}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'),$Mensagem)
    Add-Content -LiteralPath $Log -Encoding UTF8 -Value $linha
    Write-Host $linha
}
function ExigirHost {
    if ($PSVersionTable.PSVersion.Major -ne 5) { throw 'Use o Windows PowerShell 5.1 do host (nao PowerShell 7).' }
    $p=[Security.Principal.WindowsPrincipal]::new([Security.Principal.WindowsIdentity]::GetCurrent())
    if (-not $p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
        throw 'Abra Windows PowerShell COMO ADMINISTRADOR no computador host.'
    }
    if (-not (Test-Path -LiteralPath $Base -PathType Container)) { throw "Projeto nao encontrado: $Base" }
    Import-Module Hyper-V -ErrorAction Stop
    foreach ($dir in @($DirVM,(Split-Path $Log),(Split-Path $Relatorio),(Split-Path $Checklist),
                       (Split-Path $Roteiro),$Evidencias)) {
        if (-not (Test-Path -LiteralPath $dir -PathType Container)) {
            New-Item -ItemType Directory -Path $dir -Force | Out-Null
        }
    }
}
function ExigirRunning([string]$Nome) {
    $v=Get-VM -Name $Nome -ErrorAction SilentlyContinue
    if (-not $v) { throw "VM ausente: $Nome" }
    if ($v.State -ne 'Running') { throw "$Nome deve estar ligada (Running); atual: $($v.State)" }
}
function ConferirAmbiente([bool]$ComPAW) {
    ExigirRunning 'VM-FW01'
    ExigirRunning 'VM-DC01'
    if ($ComPAW) { ExigirRunning $VM }
    foreach ($nome in @('CLI-ADM01','VM-FILE01','VM-WEB01','VM-BKP01')) {
        $v=Get-VM -Name $nome -ErrorAction SilentlyContinue
        if ($v -and $v.State -ne 'Off') {
            throw "$nome precisa estar desligada para liberar RAM. Desligue normalmente e aguarde Off."
        }
    }
    $sw=Get-VMSwitch -Name 'SF-LAN' -ErrorAction Stop
    if ($sw.SwitchType -ne 'Internal') { throw 'SF-LAN nao esta definido como switch Internal.' }
}
function CredencialPAW {
    ExigirRunning $VM
    Get-Credential -Message 'Credenciais ADMINISTRATIVAS do PAW-TI01 (antes do dominio: conta local; depois: SMARTFACTORY\adm.lab ou SMARTFACTORY\Administrator)'
}
function SaidaConvidado($Dados) {
    $texto=$Dados | Out-String -Width 240
    foreach ($linha in ($texto -split "`r?`n")) {
        if ($linha.Trim()) { Registrar ('CONVIDADO | '+$linha.Trim()) }
    }
}
