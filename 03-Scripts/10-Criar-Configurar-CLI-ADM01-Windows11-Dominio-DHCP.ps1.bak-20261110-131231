# SmartFactory-GS | Etapa 08 | CLI-ADM01, Windows 11, DHCP, DNS e dominio
# Execute no Windows PowerShell 5.1 do HOST, como Administrador.
# Sequencia: Preparar -> CriarVM -> instalar Windows 11 Pro -> ConfigurarBase
# -> CriarUsuarioTeste -> IngressarDominio -> Validar.
# NAO altera FW01/DC01, nao desliga VMs e nao executa bateria final de testes.
[CmdletBinding()]
param(
    [ValidateSet('Preparar','CriarVM','ConfigurarBase','CriarUsuarioTeste','IngressarDominio','Validar')]
    [string]$Acao='Preparar',
    [string]$IsoPath=''
)
Set-StrictMode -Version Latest
$ErrorActionPreference='Stop'
$Base='D:\FIAP\WINDOWS\SmartFactory-GS'
$VM='CLI-ADM01'
$VMDir=Join-Path $Base '02-VMs\CLI-ADM01'
$VhdOS=Join-Path $VMDir 'CLI-ADM01-WIN11-OS.vhdx'
$IsoDir=Join-Path $Base '01-ISOs'
$Log=Join-Path $Base '09-Logs-Testes\10-CLI-ADM01-Windows11-Dominio-DHCP-Resultado.txt'
$Relatorio=Join-Path $Base '00-Documentacao\08-CLI-ADM01-Windows11-Dominio-DHCP.md'
$Checklist=Join-Path $Base '00-Documentacao\08-CLI-ADM01-Checklist.txt'
$Roteiro=Join-Path $Base '07-Video\Roteiros\Roteiro_Video_Etapa_9.txt'
$Evidencias=Join-Path $Base '06-Evidencias\08-CLI-ADM01-Windows11-Dominio-DHCP'
$UserTeste='lab.adm01'
$OuComputador='OU=Computadores,OU=Administracao,OU=SmartFactory,DC=smartfactory,DC=corp'
$OuUsuario='OU=Usuarios,OU=Administracao,OU=SmartFactory,DC=smartfactory,DC=corp'

function Registrar([string]$Mensagem) {
    $linha=('{0} | {1}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'),$Mensagem)
    Add-Content -LiteralPath $Log -Encoding UTF8 -Value $linha
    Write-Host $linha
}
function VerificarHost {
    if ($PSVersionTable.PSVersion.Major -ne 5) {
        throw 'Use Windows PowerShell 5.1 (nao PowerShell 7).'
    }
    $id=[Security.Principal.WindowsIdentity]::GetCurrent()
    $principal=[Security.Principal.WindowsPrincipal]::new($id)
    if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
        throw 'Abra o Windows PowerShell 5.1 COMO ADMINISTRADOR no host.'
    }
    if (-not (Test-Path -LiteralPath $Base -PathType Container)) {
        throw "Diretorio SmartFactory-GS inexistente: $Base"
    }
    Import-Module Hyper-V -ErrorAction Stop
    foreach ($p in @($VMDir,(Split-Path $Log),(Split-Path $Relatorio),
                     (Split-Path $Roteiro),$Evidencias)) {
        if (-not (Test-Path -LiteralPath $p)) {
            New-Item -Path $p -ItemType Directory -Force | Out-Null
        }
    }
}
function ExigirLigada([string]$Nome) {
    $v=Get-VM -Name $Nome -ErrorAction SilentlyContinue
    if (-not $v) { throw "$Nome nao existe no Hyper-V." }
    if ($v.State -ne 'Running') {
        throw "$Nome deve estar ligada (Running); estado atual: $($v.State)."
    }
}
function VerificarVMs([bool]$ExigirCliente) {
    foreach ($nome in @('VM-FW01','VM-DC01')) { ExigirLigada $nome }
    foreach ($nome in @('VM-FILE01','VM-WEB01','VM-BKP01')) {
        $v=Get-VM -Name $nome -ErrorAction SilentlyContinue
        if ($v -and $v.State -ne 'Off') {
            throw "$nome deve estar desligada para economizar RAM. Use Stop-VM -Name '$nome' -Shutdown e aguarde Off."
        }
    }
    $sw=Get-VMSwitch -Name 'SF-LAN' -ErrorAction Stop
    if ($sw.SwitchType -ne 'Internal') { throw 'SF-LAN nao e switch Internal.' }
    if ($ExigirCliente) { ExigirLigada $VM }
}
function ObterCredencialCliente {
    ExigirLigada $VM
    return (Get-Credential -Message 'Credenciais administrativas do CLI-ADM01 (antes do dominio: administrador LOCAL; depois: SMARTFACTORY\Administrator)')
}
function EnviarSaida($dados) {
    $texto=$dados | Out-String -Width 240
    foreach ($linha in ($texto -split "`r?`n")) {
        if ($linha.Trim().Length -gt 0) { Registrar ('CONVIDADO | ' + $linha.Trim()) }
    }
}
